# SafeForge AI - Environment Configuration Example

# GEMINI_API_KEY: Required for cloud generative AI Safety Copilot responses.
# If omitted, SafeForge AI seamlessly falls back to the deterministic ISO 45001 safety rule synthesizer.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Server Port (Default: 3000)
PORT=3000

# Node Environment
NODE_ENV=development

# SafeForge Operational Mode (true enables calibrated demonstration fixtures and sample streams)
DEMO_MODE=true

# Upload Payload Limit in Megabytes
UPLOAD_MAX_MB=50

# Optional path to local custom YOLOv8/v11 PPE PyTorch / ONNX weights
VISION_MODEL_PATH=""

# Host Application URL (injected automatically in cloud preview)
APP_URL="http://localhost:3000"
